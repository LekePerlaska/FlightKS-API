{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "RateLimiting": {
    "Store": "InMemory",
    "RedisConnectionString": "localhost:6379",
    "PublicSearch": {
      "TokenLimit": 40,
      "TokensPerPeriod": 20,
      "ReplenishmentPeriod": "00:00:10",
      "QueueLimit": 0
    },
    "SensitiveWrites": {
      "PermitLimit": 30,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6
    },
    "Global": {
      "PermitLimit": 100,
      "Window": "00:01:00",
      "SegmentsPerWindow": 6
    }
  }
}
